#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf)
  (asdf:load-asd (merge-pathnames "find-dapla-deploy.asd" *load-pathname*))
  #+quicklisp
  (let ((needed '(:cl-inix :consfigurator :fiveam :dexador)))
    (unless (every #'ql-dist:find-system (mapcar #'string-downcase needed))
      (ql-dist:install-dist "http://dist.ultralisp.org/" :prompt nil))
    (ql:quickload (list* :find-dapla-deploy/deploy :find-dapla-deploy/e2e needed)
                  :silent t)))

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(defpackage :ros.script.find-dapla-deploy.3167498364
  (:use :cl :find-dapla-deploy/deploy :find-dapla-deploy/e2e)
  (:export #:main))

(in-package :ros.script.find-dapla-deploy.3167498364)

(defun main (&rest argv)
  "Entry point for `./find-dapla-deploy.ros [e2e]`. With no arguments,
   provisions the SearXNG metasearch engine via DEPLOY-APP. With `e2e`, runs RUN-E2E
   against whatever is already deployed."
  (consfigurator:in-consfig :find-dapla-deploy/deploy)
  (unless (member "e2e" argv :test #'string=)
    (return-from main (deploy-app)))
  (run-e2e))
;;; vim: set ft=lisp lisp:
